# ============================================================
# Almenara · Configuración de Apache
# Pensada para Hostinger (Apache 2.4+).
#
# CAMBIOS RESPECTO A LA VERSIÓN ANTERIOR
#   1. font-src pasa a admitir  data:  — la tipografía Jost viaja incrustada
#      dentro de site.css, y sin este permiso el navegador la bloqueaba y caía
#      a la letra de reserva del sistema.
#   2. Fuera fonts.googleapis.com y fonts.gstatic.com. Ya no se usan: la
#      tipografía se sirve desde el propio dominio. Cero conexiones externas
#      significa que ninguna dirección IP de un visitante sale hacia un
#      tercero, que es coherente con vender a contratación pública europea.
#   3. AddType ya no marca TODOS los .json como manifiesto de aplicación web.
#      Antes, cualquier archivo .json del sitio se servía con un tipo que no
#      le corresponde. Ahora solo manifest.json y los .webmanifest.
#   4. Se añade text/javascript a la caché: las versiones recientes de Apache
#      sirven los .js con ese tipo y no con application/javascript.
#
# AVISO: las páginas de legal/ y el 404 siguen cargando la tipografía desde
# Google. Al retirar el permiso dejarán de recibirla y se verán con la letra
# del sistema. Siguen funcionando y siguen siendo legibles; solo pierden el
# tipo de letra. Se arregla cuando rehagamos esas cuatro páginas.
# ============================================================

# ------------------------------------------------------------
# 1. Juego de caracteres
# ------------------------------------------------------------
AddDefaultCharset UTF-8

# ------------------------------------------------------------
# 2. Forzar HTTPS y quitar el www
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# ------------------------------------------------------------
# 3. Página de error propia
# ------------------------------------------------------------
ErrorDocument 404 /404.html

# ------------------------------------------------------------
# 4. Cabeceras de seguridad
# ------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

    # Política de contenidos.
    #   script-src 'self'  → el JavaScript SIEMPRE en archivos aparte, nunca
    #                        escrito dentro del HTML. Si algún día los botones
    #                        dejan de responder, mirar esto lo primero.
    #   font-src  'self' data:  → autoriza la tipografía incrustada.
    #   img-src   'self' data:  → autoriza el grano y los iconos incrustados.
    #   form-action 'self' mailto:  → el formulario de contacto abre el gestor
    #                        de correo del visitante. Sin el "mailto:" el botón
    #                        de enviar no hace nada en absoluto.
    Header always set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' mailto:; upgrade-insecure-requests"

    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
</IfModule>

# ------------------------------------------------------------
# 5. Compresión
# ------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/manifest+json
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE image/svg+xml
    # Los .woff2 NO se comprimen: ya vienen comprimidos y volver a hacerlo
    # solo gasta procesador para dejarlos igual o un poco más grandes.
</IfModule>

# ------------------------------------------------------------
# 6. Caché del navegador
# ------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType text/html "access plus 0 seconds"

    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"

    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    ExpiresByType application/manifest+json "access plus 1 week"
    ExpiresByType application/xml "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=0, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(css|js|woff2|woff|ttf|otf|jpg|jpeg|png|webp|avif|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ------------------------------------------------------------
# 7. Sin listados de directorio
# ------------------------------------------------------------
Options -Indexes

# ------------------------------------------------------------
# 8. Archivos que no debe ver nadie
# ------------------------------------------------------------
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<Files "*.md">
    Require all denied
</Files>

<Files "LICENSE">
    Require all denied
</Files>

# ------------------------------------------------------------
# 9. Tipos MIME
# ------------------------------------------------------------
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType application/json .json
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType image/webp .webp
    AddType image/avif .avif
</IfModule>

# El manifiesto de la aplicación, y solo él, lleva su propio tipo.
<Files "manifest.json">
    ForceType application/manifest+json
</Files>
